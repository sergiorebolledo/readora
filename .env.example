# Copia este archivo como .env.local y rellena lo que uses. .env.local no se sube a git.

# Analítica (Firebase / Google Analytics). Sin estos datos, la analítica queda apagada y no se muestra el aviso.
# Salen de Firebase console → Configuración del proyecto → Tus apps → app web (firebaseConfig).
# En Android además hace falta android/app/google-services.json (no se sube a git).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Banner de AdMob (Android). Vacío = anuncios de PRUEBA de Google.
# El ID de la APP va en android/app/src/main/res/values/strings.xml (admob_app_id).
VITE_ADMOB_BANNER_ID=

# Suscripción "sin anuncios" (RevenueCat, Android). Clave PÚBLICA de Android (empieza con goog_).
# Vacío = no se ofrece la suscripción.
VITE_REVENUECAT_KEY=

# Enlace de donaciones (GitHub Sponsors, Ko-fi…). Vacío = no se muestra la sección.
VITE_DONATE_URL=
