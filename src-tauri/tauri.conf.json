{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Readora",
  "mainBinaryName": "Readora",
  "version": "../package.json",
  "identifier": "app.readora",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Readora",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0d0b1f",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "publisher": "Readora",
    "copyright": "GPL-3.0-or-later",
    "category": "Education",
    "shortDescription": "Biblioteca de libros gratis",
    "longDescription": "Readora: busca, descarga y lee libros gratis de dominio público (Project Gutenberg, Open Library) en PDF y EPUB.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English", "PortugueseBR", "French"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["es-ES", "en-US"]
      }
    }
  }
}
